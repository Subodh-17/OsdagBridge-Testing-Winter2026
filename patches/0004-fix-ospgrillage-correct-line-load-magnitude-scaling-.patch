From 34cd4bf5bf5324034a74161e2e6c603560a433e5 Mon Sep 17 00:00:00 2001
From: Subodh Bansode <subodh171011@gmail.com>
Date: Thu, 19 Nov 2026 17:43:46 +0530
Subject: [PATCH 4/6] fix(ospgrillage): correct line load magnitude scaling,
 vector centroid, and coordinate index (DEF-18-LINE)

- Multiply average segment intensity by segment length (mag = W * L)
- Replace get_point_given_distance with direct parametric vector interpolation
- Implement zero-crossing segment partitioning for opposite-sign loads
- Fix transverse coordinate index in interpolate_udl_magnitude call (p1[2])
- Raise explicit ValueError on out-of-mesh load placement in _assign_load_to_four_node
---
 src/ospgrillage/osp_grillage.py | 62 +++++++++++++++++++++++----------
 1 file changed, 44 insertions(+), 18 deletions(-)

diff --git a/src/ospgrillage/osp_grillage.py b/src/ospgrillage/osp_grillage.py
index 61dad03..ba04951 100644
--- a/src/ospgrillage/osp_grillage.py
+++ b/src/ospgrillage/osp_grillage.py
@@ -1575,8 +1575,9 @@ class OspGrillage:
         # search grid where the point lies in
         grid_nodes, _ = self._get_point_load_nodes(point=point)
         if grid_nodes is None:
-            load_str = []
-            return load_str
+            raise ValueError(
+                f"Point load coordinate {point} does not lie within any mesh grid cell."
+            )
         # if corner or edge grid with 3 nodes, run specific assignment for triangular grids
         # extract coordinates
         p1 = self.Mesh_obj.node_spec[grid_nodes[0]]["coordinate"]
@@ -1709,23 +1710,48 @@ class OspGrillage:
 
             # get length of line
             L = np.sqrt((p1[0] - p2[0]) ** 2 + (p1[2] - p2[2]) ** 2)
+            if L < 1e-12:
+                continue
 
-            # get magnitudes at point 1 and point 2
-            w1 = line_load_obj.interpolate_udl_magnitude([p1[0], 0, p1[1]])
-            w2 = line_load_obj.interpolate_udl_magnitude([p2[0], 0, p2[1]])
-
-            W = (w1 + w2) / 2
-            # get mid point of line
-            x_bar = ((2 * w1 + w2) / (w1 + w2)) * L / 3  # from p2
-            load_point = line_load_obj.get_point_given_distance(
-                xbar=x_bar, point_coordinate=[p2[0], self.y_elevation, p2[2]]
-            )
-
-            # uses point load assignment function to assign load point and mag to four nodes in grid
-            load_str = self._assign_load_to_four_node(
-                point=load_point, mag=W, shape_func=line_load_obj.shape_function
-            )
-            load_str_line += load_str  # append to major list for line load
+            # get magnitudes at point 1 and point 2 (pass transverse z = p[2])
+            w1 = line_load_obj.interpolate_udl_magnitude([p1[0], self.y_elevation, p1[2]])
+            w2 = line_load_obj.interpolate_udl_magnitude([p2[0], self.y_elevation, p2[2]])
+
+            if (w1 * w2) < 0:
+                # Zero-crossing detected: partition into two triangular lobes at zero crossing
+                s0_ratio = abs(w1) / (abs(w1) + abs(w2))
+                p0 = [p1[i] + s0_ratio * (p2[i] - p1[i]) for i in range(3)]
+
+                # Lobe 1 (p1 to p0): w1 to 0.0 -> centroid at 1/3 from p1
+                mag1 = (w1 / 2.0) * (L * s0_ratio)
+                pt1 = [p1[i] + (1.0 / 3.0) * (p0[i] - p1[i]) for i in range(3)]
+                pt1[1] = self.y_elevation
+                load_str1 = self._assign_load_to_four_node(
+                    point=pt1, mag=mag1, shape_func=line_load_obj.shape_function
+                )
+                load_str_line += load_str1
+
+                # Lobe 2 (p0 to p2): 0.0 to w2 -> centroid at 2/3 from p0
+                mag2 = (w2 / 2.0) * (L * (1.0 - s0_ratio))
+                pt2 = [p0[i] + (2.0 / 3.0) * (p2[i] - p0[i]) for i in range(3)]
+                pt2[1] = self.y_elevation
+                load_str2 = self._assign_load_to_four_node(
+                    point=pt2, mag=mag2, shape_func=line_load_obj.shape_function
+                )
+                load_str_line += load_str2
+            elif abs(w1 + w2) < 1e-12:
+                # Net zero load on segment; skip assignment
+                pass
+            else:
+                # Standard single-lobe trapezoid (guaranteed t in [1/3, 2/3] for non-negative loads)
+                t = (w1 + 2.0 * w2) / (3.0 * (w1 + w2))
+                pt = [p1[i] + t * (p2[i] - p1[i]) for i in range(3)]
+                pt[1] = self.y_elevation
+                mag = ((w1 + w2) / 2.0) * L
+                load_str = self._assign_load_to_four_node(
+                    point=pt, mag=mag, shape_func=line_load_obj.shape_function
+                )
+                load_str_line += load_str
 
         # loop through all colinear elements
         # for each colinear element, assign line load to two nodes of element

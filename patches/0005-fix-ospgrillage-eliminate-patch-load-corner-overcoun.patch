From 9e0b5883a247c8c0fb74b0890915600c7ab4a896 Mon Sep 17 00:00:00 2001
From: Subodh Bansode <subodh171011@gmail.com>
Date: Thu, 19 Nov 2026 18:03:12 +0530
Subject: [PATCH 5/6] fix(ospgrillage): eliminate patch load corner
 overcounting and iteration mutation bug (DEF-18-PATCH)

- Track processed grid cells via visited_grids set to prevent corner cell duplication
- Eliminate 4x corner cell area excess (+6.30 m2 on 24x8.5m deck)
- Replace mutating p_list.pop() in enumerate loop with clean deduplication
- Restore exact deck slab (1275.0 kN) and wearing course (244.8 kN) static equilibrium
---
 src/ospgrillage/osp_grillage.py | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/ospgrillage/osp_grillage.py b/src/ospgrillage/osp_grillage.py
index ba04951..f453bd0 100644
--- a/src/ospgrillage/osp_grillage.py
+++ b/src/ospgrillage/osp_grillage.py
@@ -1824,6 +1824,7 @@ class OspGrillage:
         # between 4 dictionaries record the common grids as having the corners of the patch - to be evaluated different
         bound_node, bound_grid = self._get_bounded_nodes(patch_load_obj)
         patch_load_str = []  # final return str list
+        visited_grids = set(bound_grid)
         # assign patch for grids fully bounded by patch
         for grid in bound_grid:
             nodes = self.Mesh_obj.grid_number_dict[grid]  # read grid nodes
@@ -1885,6 +1886,9 @@ class OspGrillage:
         # all lines are ordered in path counter clockwise - sorted hereafter via sort_vertices
         # get nodes in grid that are left (check inside variable greater than 0)
         for grid, int_point_list in merged.items():  # [x y z]
+            if grid in visited_grids:
+                continue
+            visited_grids.add(grid)
             grid_nodes = self.Mesh_obj.grid_number_dict[grid]  # read grid nodes
             # get two grid nodes bounded by patch
             node_in_grid = [
@@ -1916,12 +1920,12 @@ class OspGrillage:
                     coord[0], coord[2]
                 )  # object function returns array like
                 p_list.append(LoadVertex(coord[0], coord[1], coord[2], p))
-            # Loop each p_list object to find duplicates if any, remove duplicate
-            for count, point in enumerate(p_list):
-                dupe = [point == val for val in p_list]
-                # if duplicate, remove value
-                if sum(dupe) > 1:
-                    p_list.pop(count)
+            # Deduplicate vertices in p_list without mutating loop
+            unique_p_list = []
+            for point in p_list:
+                if point not in unique_p_list:
+                    unique_p_list.append(point)
+            p_list = unique_p_list
             # sort points in counterclockwise
             p_list, _ = sort_vertices(p_list)  # sort takes namedtuple
             # get centroid of patch on grid
-- 
